# Copy to .env and fill from: cd infrastructure/terraform && terraform output
APP_NAME=agentic-aws-docs-assistant
LOG_LEVEL=INFO

# CloudWatch (EC2): terraform output cloudwatch_ingestion_log_group
CLOUDWATCH_LOGS_ENABLED=false
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_LOG_STREAM=

AWS_REGION=ap-south-1
# Local dev: aws configure OR export AWS_PROFILE=your-profile (after aws sso login)

S3_BUCKET=
S3_PROCESSED_BUCKET=
S3_PROCESSED_PREFIX=processed/

DYNAMODB_REGISTRY_TABLE=

OPENSEARCH_HOST=
OPENSEARCH_PORT=443
OPENSEARCH_INDEX=aws-docs
OPENSEARCH_AUTH_MODE=aws_sigv4
OPENSEARCH_USE_SSL=true
OPENSEARCH_TIMEOUT=60

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
INGESTION_MAX_WORKERS=1

CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=1200
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
CHUNK_MAX_SPLIT_DEPTH=3
CHUNK_MAX_CHUNKS_PER_DOCUMENT=500

OPENSEARCH_BULK_BATCH_SIZE=50

SEARCH_VECTOR_K=25
SEARCH_RERANK_CANDIDATES=10
RERANKER_MODEL_ID=BAAI/bge-reranker-base
RERANKER_ENABLED=true
WARMUP_MODELS_ON_STARTUP=true
SEARCH_TIMEOUT=120
HEALTH_OPENSEARCH_TIMEOUT=10

DOCS_BASE_URL=https://docs.aws.amazon.com
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
